# Base URL of the backend API. Leave empty to use the in-browser mock.
VITE_API_URL=http://localhost:8000

# "true" forces the mock API; "false" uses the real backend.
# Defaults to true when VITE_API_URL is empty.
VITE_USE_MOCK=false

# "true" gates the doctor/admin routes behind login. "false" opens them
# with a demo doctor identity (handy for UI-only work).
VITE_AUTH_ENABLED=true

# Optional: show an extra verification field (DOB / PIN) on the patient page.
# Requires backend support for a second factor.
VITE_PATIENT_SECOND_FACTOR=false
