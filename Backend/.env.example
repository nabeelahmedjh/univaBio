# ---- App ----
APP_NAME=univaBio Backend
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins
# Include both localhost and 127.0.0.1 — CORS matching is exact per origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ---- Database ----
# SQLite file lives under Backend/ by default
DATABASE_URL=sqlite:///./univabio.db

# ---- Security ----
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- Super admin (creates doctor profiles) ----
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASS=change-me-super-admin-pass

# ---- LLM (Google AI Studio / Gemini: https://aistudio.google.com/app/apikey) ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.2

# ---- Speech-to-text (local Whisper) ----
# Model size: tiny | base | small | medium | large ('tiny' is fastest on CPU)
WHISPER_MODEL=tiny
# Directory where uploaded audio files are stored before transcription
AUDIO_UPLOAD_DIR=uploads
